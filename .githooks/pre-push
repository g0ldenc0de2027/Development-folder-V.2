#!/bin/sh
set -eu
remote_name=$1
remote_url=$2
repo_root=$(git rev-parse --show-toplevel) || {
    echo "pre-push: repository root could not be resolved" >&2
    exit 1
}
if ! command -v pwsh >/dev/null 2>&1; then
    echo "pre-push: PowerShell 7 is required" >&2
    exit 1
fi
push_ranges=
append_range() {
    if [ -n "$push_ranges" ]; then
        push_ranges="$push_ranges
$1"
    else
        push_ranges=$1
    fi
}
while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    if [ -z "$local_ref" ] && [ -z "$local_sha" ]; then continue; fi
    case "$local_sha" in
        *[!0123456789abcdefABCDEF]*|'') echo "pre-push: invalid local object ID" >&2; exit 1 ;;
    esac
    case "$local_sha" in
        *[!0]*) ;;
        *) echo "pre-push: ref deletion or missing local object is forbidden" >&2; exit 1 ;;
    esac
    case "$remote_sha" in
        *[!0123456789abcdefABCDEF]*|'') echo "pre-push: invalid remote object ID" >&2; exit 1 ;;
    esac
    case "$remote_sha" in
        *[!0]*) append_range "$remote_sha..$local_sha" ;;
        *) append_range "$local_sha" ;;
    esac
done
if [ -n "$push_ranges" ]; then
    pwsh -NoLogo -NoProfile -File "$repo_root/scripts/verify-git-identity.ps1" -RemoteName "$remote_name" -CommitRange "$push_ranges"
else
    pwsh -NoLogo -NoProfile -File "$repo_root/scripts/verify-git-identity.ps1" -RemoteName "$remote_name"
fi
if [ -n "$push_ranges" ]; then
    exec pwsh -NoLogo -NoProfile -File "$repo_root/scripts/quality-gate.ps1" -RemoteName "$remote_name" -RemoteUrl "$remote_url" -PushRange "$push_ranges"
fi
exec pwsh -NoLogo -NoProfile -File "$repo_root/scripts/quality-gate.ps1" -RemoteName "$remote_name" -RemoteUrl "$remote_url"
