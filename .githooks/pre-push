#!/bin/sh
set -eu

remote_name=${1-}
remote_url=${2-}

repo_root=$(git rev-parse --show-toplevel) || {
    echo "pre-push: repository root could not be resolved" >&2
    exit 1
}

if ! command -v pwsh >/dev/null 2>&1; then
    echo "pre-push: PowerShell 7 is required" >&2
    exit 1
fi

set --
while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    if [ -z "${local_ref:-}" ] && [ -z "${local_sha:-}" ]; then
        continue
    fi

    case "${local_sha:-}" in
        *[!0]*) ;;
        *)
            echo "pre-push: ref deletion or missing local object is forbidden" >&2
            exit 1
            ;;
    esac

    case "${remote_sha:-}" in
        *[!0]*) set -- "$@" "${remote_sha}..${local_sha}" ;;
        *) set -- "$@" "$local_sha" ;;
    esac
done

if [ "$#" -gt 0 ]; then
    exec pwsh -NoLogo -NoProfile -File "$repo_root/scripts/quality-gate.ps1" -RemoteName "$remote_name" -RemoteUrl "$remote_url" -PushRange "$@"
fi

exec pwsh -NoLogo -NoProfile -File "$repo_root/scripts/quality-gate.ps1" -RemoteName "$remote_name" -RemoteUrl "$remote_url"
