#!/bin/sh
set -eu
remote_name=$1
remote_url=$2
if ! command -v pwsh >/dev/null 2>&1; then
    echo "pre-push: PowerShell 7 is required" >&2
    exit 1
fi
if ! command -v cygpath >/dev/null 2>&1; then
    echo "pre-push: Git for Windows cygpath is required for the hook context check" >&2
    exit 1
fi
hook_pwd=$(pwd -P) || {
    echo "pre-push: current directory could not be resolved" >&2
    exit 1
}
repo_root=$(cygpath -aw "$hook_pwd") || {
    echo "pre-push: worktree path could not be converted safely" >&2
    exit 1
}
if ! pwsh -NoLogo -NoProfile -File "$repo_root/scripts/verify-git-hook-context.ps1" -RepositoryRoot "$repo_root"; then
    echo "pre-push: Git hook context gate blocked push" >&2
    exit 1
fi
repo_root=$(git rev-parse --show-toplevel) || {
    echo "pre-push: repository root could not be resolved" >&2
    exit 1
}
worktree_status=$(git status --porcelain=v1 --untracked-files=all --ignore-submodules=none) || {
    echo "pre-push: current worktree status could not be verified" >&2
    exit 1
}
if [ -n "$worktree_status" ]; then
    echo "pre-push: current worktree is not clean; preserve and commit all task changes before publishing" >&2
    exit 1
fi
if ! pwsh -NoLogo -NoProfile -File "$repo_root/scripts/task-worktree-audit.ps1" -Mode Publish; then
    echo "pre-push: task worktree audit blocked publish" >&2
    exit 1
fi
current_ref=$(git symbolic-ref --quiet HEAD) || {
    echo "pre-push: detached HEAD is not allowed" >&2
    exit 1
}
case "$current_ref" in
    refs/heads/task/T-[0-9][0-9][0-9]) ;;
    refs/heads/task/T-[0-9][0-9][0-9]-*)
        task_slug=${current_ref#refs/heads/task/T-[0-9][0-9][0-9]-}
        case "$task_slug" in
            ''|-*|*-|*--*|*[!a-z0-9-]*)
                echo "pre-push: task branch slug must use lowercase letters, digits and single hyphens" >&2
                exit 1
                ;;
            *) ;;
        esac
        ;;
    *) echo "pre-push: only task/T-NNN or task/T-NNN-lowercase-slug branches may be pushed" >&2; exit 1 ;;
esac

task_branch=${current_ref#refs/heads/task/}
task_id=${task_branch%${task_branch#?????}}
push_range=
outgoing_sha=
while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    if [ -z "$local_ref" ] && [ -z "$local_sha" ]; then continue; fi
    case "$local_ref:$remote_ref" in
        refs/heads/task/T-013:*|refs/heads/task/T-013-*:*|*:refs/heads/task/T-013|*:refs/heads/task/T-013-*)
            echo "pre-push: T-013 is a read-only recovery source and cannot be published" >&2
            exit 1
            ;;
    esac
    if [ "$local_ref" != "$current_ref" ] || [ "$remote_ref" != "$local_ref" ]; then
        echo "pre-push: only the current same-named task branch may be updated" >&2
        exit 1
    fi
    if [ -n "$outgoing_sha" ]; then
        echo "pre-push: only one task ref may be updated" >&2
        exit 1
    fi
    case "$local_sha" in
        *[!0123456789abcdefABCDEF]*|'') echo "pre-push: invalid local object ID" >&2; exit 1 ;;
    esac
    case "$local_sha" in
        *[!0]*) ;;
        *) echo "pre-push: ref deletion or missing local object is forbidden" >&2; exit 1 ;;
    esac
    case "$remote_sha" in
        *[!0123456789abcdefABCDEF]*|'') echo "pre-push: invalid remote object ID" >&2; exit 1 ;;
    esac
    case "$remote_sha" in
        *[!0]*)
            if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
                echo "pre-push: non-fast-forward update or missing remote object is forbidden" >&2
                exit 1
            fi
            push_range="$remote_sha..$local_sha"
            ;;
        *) push_range="$local_sha" ;;
    esac
    outgoing_sha=$local_sha
done
if [ -z "$outgoing_sha" ]; then
    pwsh -NoLogo -NoProfile -File "$repo_root/scripts/verify-git-identity.ps1" -RepositoryRoot "$repo_root" -HookContext -RemoteName "$remote_name"
    exec pwsh -NoLogo -NoProfile -File "$repo_root/scripts/quality-gate.ps1" -RemoteName "$remote_name" -RemoteUrl "$remote_url"
fi

published_main=$(pwsh -NoLogo -NoProfile -File "$repo_root/scripts/verify-git-identity.ps1" -RepositoryRoot "$repo_root" -HookContext -RemoteName "$remote_name" -RemoteUrl "$remote_url" -CommitRange "$push_range" -PassThruPublishedMainSha)
published_main=$(printf '%s' "$published_main" | tr -d '\r')
case "$published_main" in
    ''|*[!0123456789abcdef]*) echo "pre-push: verified live main SHA is invalid" >&2; exit 1 ;;
esac
if [ "${#published_main}" -ne 40 ]; then
    echo "pre-push: verified live main SHA is invalid" >&2
    exit 1
fi
pwsh -NoLogo -NoProfile -File "$repo_root/scripts/verify-task-scope.ps1" -TaskId "$task_id" -BaseRef "$published_main" -ExpectedHeadSha "$outgoing_sha"
pwsh -NoLogo -NoProfile -File "$repo_root/scripts/quality-gate.ps1" -BaseRef "$published_main" -RemoteName "$remote_name" -RemoteUrl "$remote_url" -PushRange "$push_range"

if [ "$(git symbolic-ref --quiet HEAD)" != "$current_ref" ] || [ "$(git rev-parse --verify HEAD)" != "$outgoing_sha" ]; then
    echo "pre-push: the checked-out task revision changed during checks; retry after reviewing it" >&2
    exit 1
fi
